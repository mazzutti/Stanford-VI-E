[flake8]
max-line-length = 120
# Ignore formatting conflicts with Black:
# E203: whitespace before ':' (Black intentionally uses spaces around slice notation)
# W503: line break before binary operator (Black breaks before operators)
# E704: multiple statements on one line (Protocol methods use '...')
ignore = E203, W503, E704
exclude =
    .git,
    __pycache__,x
    .venv,
    .mypy_cache,
    .pytest_cache,
    .ipynb_checkpoints,
