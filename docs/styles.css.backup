  background: rgba(245, 158, 11, 0.1);
  color: #b45309;
  padding: 0.25rem var(--spacing-sm);
  border-radius: 12px;
  font-size: var(--spacing-sm);
  font-weight: 600;
}

.badge-inline-114 {
  display: inline-block;
