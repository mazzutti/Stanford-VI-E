}

/* Consolidated active states */
.btn-primary:active,
.back-to-top:active {
  transform: translateY(0);
}

/* Consolidated utility classes - merged duplicates */
.copy-code-btn i,
.text-sm {
  font-size: 0.85rem;
}

.stat-value,

.viz-container,
.p-1 {
