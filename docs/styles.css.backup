  font-weight: 600;
}

.badge-inline-111 {
  display: inline-block;
  background: rgba(16, 185, 129, 0.1);
  color: #047857;
  padding: 0.25rem var(--spacing-sm);
  border-radius: 12px;
  font-size: var(--spacing-sm);
  font-weight: 600;
}

.badge-inline-112 {
  display: inline-block;
  background: rgba(236, 72, 153, 0.1);
  color: var(--color-pink-800);
  padding: 0.25rem var(--spacing-sm);
  border-radius: 12px;
  font-size: var(--spacing-sm);
