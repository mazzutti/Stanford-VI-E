}

.text-base-secondary-lh-15-m0 {
  font-size: 0.875rem;
  color:
    var(--text-secondary);
  line-height: 1.5;
  margin: 0;
}

.text-sm-bold-primary-mb-1 {
  font-weight: 700;
  color: var(--text-primary);
