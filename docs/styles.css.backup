}

.btn-primary-gradient {
  display: inline-block;
  padding: 0.75rem var(--spacing-lg);
  background: linear-gradient(135deg, #5e72e4 0%, #825ee4 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: var(--spacing-base);
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
